# Local demo may use its development-only fallback. Set a unique secret for deployment.
COLLEGEHUB_SECRET_KEY=

# Optional: set to 1 to disable local SQLite admin writes outside Vercel.
COLLEGEHUB_READ_ONLY=

# Optional: set to 1 when serving over HTTPS outside production Vercel.
COLLEGEHUB_SECURE_COOKIES=

# Optional: enable Flask's debugger only for local development.
COLLEGEHUB_DEBUG=
