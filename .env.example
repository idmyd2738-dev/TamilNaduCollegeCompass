# Local demo may use its development-only fallback. Set a unique secret for deployment.
COLLEGEHUB_SECRET_KEY=

# Optional: enable the single-administrator database review console with a
# Werkzeug password hash. Never store the administrator's plain password here.
COLLEGEHUB_ADMIN_PASSWORD_HASH=

# Optional: set to 1 to disable local SQLite admin writes outside Vercel.
# Also disables the database administration console.
COLLEGEHUB_READ_ONLY=

# Optional: set to 1 when serving over HTTPS outside production Vercel.
COLLEGEHUB_SECURE_COOKIES=

# Optional: enable Flask's debugger only for local development.
COLLEGEHUB_DEBUG=

# Optional: enable fictional legacy SQLite pages only for local demonstration.
# Never enable this in a deployed environment.
COLLEGEHUB_DEMO_MODE=

# Optional local universal database override. Without this, instance/collegehub.sqlite3 is used.
# Deployed environments must configure persistent PostgreSQL and run reviewed migrations separately.
DATABASE_URL=

# AI-powered chatbot and document indexing (OpenAI-compatible API)
# Keep all credentials in your local .env or deployment secret manager.
COLLEGEHUB_AI_API_KEY=
COLLEGEHUB_AI_BASE_URL=https://api.openai.com/v1
COLLEGEHUB_AI_CHAT_MODEL=gpt-4o-mini
COLLEGEHUB_AI_EMBEDDING_MODEL=text-embedding-3-small
# Optional: reject embeddings whose returned dimension differs from this value.
COLLEGEHUB_EMBEDDING_DIMENSIONS=
